# CodeCraft environment template.
#
# This file is documentation. Nothing loads it. Copy each section into the file it names,
# and never commit those files:
#   backend/.env         sections marked [backend]
#   agent/.env           sections marked [agent]
#   frontend/.env.local  sections marked [frontend]
# This file stays at the repository root, so one template describes the whole project.
#
# Rules:
# - Only variables prefixed VITE_ reach the browser. Never put a secret under VITE_.
# - Each service reads only its own section.
# - Adding a variable means adding it here, with a comment, in the same change.

# ---------------------------------------------------------------- [backend] App
CODECRAFT_ENV=development                 # development | test | production
CODECRAFT_LOG_LEVEL=info
# Browser origin the API answers for. Only this origin is allowed by CORS.
CODECRAFT_FRONTEND_ORIGIN=http://localhost:5173

# ---------------------------------------------------------------- [backend] Database
# Connection string for the restricted API role, through the Supabase transaction pooler.
# Never use the postgres user: it bypasses row-level security. Filled in during the database phase.
DATABASE_URL=
# Connection string for the membership sync role, through the Supabase transaction pooler.
# That role can write the membership table and nothing else. The Clerk webhook uses it.
MEMBERSHIP_SYNC_DATABASE_URL=

# ---------------------------------------------------------------- [backend] Clerk: identity and membership sync
# Used to verify user tokens against Clerk's published keys.
CLERK_JWT_ISSUER=https://<your-clerk-domain>
# Verifies that membership webhooks came from Clerk. Grants no data access.
CLERK_WEBHOOK_SIGNING_SECRET=

# ---------------------------------------------------------------- [backend] Agent tokens
# The API signs short-lived tokens that name one organization and one analysis.
# The agent carries them; it never holds this key. Generate with a cryptographically random generator.
AGENT_TOKEN_SIGNING_KEY=
AGENT_TOKEN_TTL_SECONDS=300
# Where the API reaches the agent service.
AGENT_SERVICE_URL=http://localhost:8080

# ---------------------------------------------------------------- [backend] TypeScript resolver
# The resolver is a Node helper that uses the TypeScript compiler. Its version is pinned in the project.
RESOLVER_TIMEOUT_SECONDS=30

# ---------------------------------------------------------------- [backend] Parsing limits
# Explicit limits, so a large repository fails with a stated reason instead of hanging.
PARSE_MAX_FILES=20000
PARSE_MAX_FILE_BYTES=2000000
PARSE_WORKERS=                            # optional; empty means one worker per CPU core

# ---------------------------------------------------------------- [backend] GitHub ingestion
# Public repositories only. An operator token is optional and only raises the anonymous rate limit.
GITHUB_OPERATOR_TOKEN=
DOWNLOAD_TIMEOUT_SECONDS=60

# ---------------------------------------------------------------- [backend] Explanations and evaluation
# One model-client module reads these. Nothing has a default in code: the application
# refuses to start if a value is missing, and it sends requests only to LLM_BASE_URL.
# LLM_API_PROTOCOL: openai-compatible | anthropic-compatible
LLM_API_PROTOCOL=
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=

# ---------------------------------------------------------------- [backend] Tracing
# OpenTelemetry is the instrumentation. LangSmith is the first backend.
# Confirm the region and retention before any repository content is sent. See the design document.
OTEL_SERVICE_NAME=codecraft-api
OTEL_EXPORTER_OTLP_ENDPOINT=              # set to the LangSmith OTLP endpoint for your region
OTEL_EXPORTER_OTLP_HEADERS=               # secret if set
LANGSMITH_API_KEY=                        # secret; used for datasets and experiments
LANGSMITH_PROJECT=codecraft

# ---------------------------------------------------------------- [agent] Agent service
# The agent runs as its own service. It has no database credential and no signing key.
CODECRAFT_API_URL=http://localhost:8000
# The agent's model, configured the same way as the backend's.
LLM_API_PROTOCOL=
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=
# Tracing for the agent, using the same backend as the API.
OTEL_SERVICE_NAME=codecraft-agent
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=codecraft

# ---------------------------------------------------------------- [frontend] Public values only
VITE_CLERK_PUBLISHABLE_KEY=
VITE_API_URL=http://localhost:8000
