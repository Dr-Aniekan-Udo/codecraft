# CodeCraft environment template.
#
# This file is documentation. Nothing loads it. Copy each section into the file it names,
# and never commit those files:
#   backend/.env         sections marked [backend]
#   frontend/.env.local  sections marked [frontend]
# This file stays at the repository root, so one template describes the whole project.
#
# Rules:
# - Only variables prefixed VITE_ reach the browser. Never put a secret under VITE_.
# - The backend reads only [backend] variables. The frontend reads only [frontend] variables.
# - Adding a variable means adding it here, with a comment, in the same change.

# ---------------------------------------------------------------- [backend] App
CODECRAFT_ENV=development                 # development | test | production
CODECRAFT_LOG_LEVEL=info

# ---------------------------------------------------------------- [backend] Database
# Connection string for the restricted API role, through the Supabase transaction pooler.
# Never use the postgres user: it bypasses row-level security. Filled in during the database phase.
DATABASE_URL=

# ---------------------------------------------------------------- [backend] Clerk: identity and membership sync
# Used to verify user tokens against Clerk's published keys.
CLERK_JWT_ISSUER=https://<your-clerk-domain>
# Verifies that membership webhooks came from Clerk. Grants no data access.
CLERK_WEBHOOK_SIGNING_SECRET=

# ---------------------------------------------------------------- [backend] Parsing limits
# Explicit limits, so a large repository fails with a stated reason instead of hanging.
PARSE_MAX_FILES=20000
PARSE_MAX_FILE_BYTES=2000000
PARSE_WORKERS=                            # optional; empty means one worker per CPU core

# ---------------------------------------------------------------- [backend] LLM (added in the explanation phase)
# Configured by wire protocol, not provider name. Nothing has a default in code:
# the application refuses to start if a value is missing, and it sends requests only to LLM_BASE_URL.
# LLM_API_PROTOCOL: openai-compatible | anthropic-compatible
LLM_API_PROTOCOL=
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=

# ---------------------------------------------------------------- [backend] Tracing (added in the observability phase)
OTEL_SERVICE_NAME=codecraft
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=               # secret if set

# ---------------------------------------------------------------- [backend] GitHub (added in the ingestion phase)
# Public repositories only. An operator token is optional and only raises the anonymous rate limit.
GITHUB_OPERATOR_TOKEN=

# ---------------------------------------------------------------- [frontend] Public values only
VITE_CLERK_PUBLISHABLE_KEY=
VITE_API_URL=http://localhost:8000
