# CodeCraft environment template.
# Copy to a local env file and fill in values. The real file is never committed.
#
# Rules that apply to every variable below:
# - Only the frontend reads VITE_* variables, and everything with that prefix is
#   published to the browser. Never put a secret under VITE_.
# - The API process reads only the variables in its own section. It never receives
#   the migration credential.
# - Adding a variable means adding it here, with a comment, in the same change.

# ---------------------------------------------------------------- App
CODECRAFT_ENV=development            # development | test | production
CODECRAFT_LOG_LEVEL=info

# ---------------------------------------------------------------- Database (API process)
# Direct Postgres connection string for the application role. This role has no
# bypass-RLS privilege. Row-level policies decide every read and write.
DATABASE_URL=postgresql://codecraft_app:CHANGE_ME@localhost:5432/postgres

# ---------------------------------------------------------------- Supabase (API process)
# Used only to fetch the project's public signing keys (JWKS) and check the
# signature and issuer of user tokens. The API holds no Supabase secret key.
SUPABASE_URL=http://localhost:54321
SUPABASE_JWT_ISSUER=http://localhost:54321/auth/v1

# ---------------------------------------------------------------- Migrations (never loaded by the app)
# Owner-level credential used only when applying schema migrations, from a
# terminal or CI job. The running API must not read this variable.
SUPABASE_MIGRATION_DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:54322/postgres

# ---------------------------------------------------------------- Frontend (public values only)
VITE_SUPABASE_URL=http://localhost:54321
VITE_SUPABASE_PUBLISHABLE_KEY=CHANGE_ME_PUBLISHABLE_KEY
VITE_API_URL=http://localhost:8000

# ---------------------------------------------------------------- LLM (API process, agent)
# The client module reads these. Configuration is selected by wire protocol, not by
# provider name, because many providers and local servers speak one of two protocols.
#
# LLM_API_PROTOCOL: openai-compatible | anthropic-compatible
#   openai-compatible    e.g. OpenAI, or any server exposing the chat completions API
#   anthropic-compatible e.g. Anthropic, or any server exposing the messages API
#
# Nothing here has a default in code. The application refuses to start if a value is
# missing or empty, and it never sends requests to a host other than LLM_BASE_URL.
LLM_API_PROTOCOL=openai-compatible
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=60

# ---------------------------------------------------------------- Tracing (API process, agent)
# OpenTelemetry is the instrumentation. The backend is chosen by these variables.
OTEL_SERVICE_NAME=codecraft
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=          # e.g. x-api-key=... ; secret if set
# Optional, if the backend is LangSmith:
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=codecraft

# ---------------------------------------------------------------- GitHub ingestion (API process)
# Public repositories only, so no user token is involved. An operator token is
# optional and only raises the anonymous rate limit. Leave empty to run without it.
GITHUB_OPERATOR_TOKEN=

# ---------------------------------------------------------------- Parsing limits (API process)
# Explicit limits, so a large repository fails with a stated reason instead of
# hanging or exhausting memory.
PARSE_MAX_FILES=20000
PARSE_MAX_FILE_BYTES=2000000
PARSE_WORKERS=                       # empty = number of CPU cores
