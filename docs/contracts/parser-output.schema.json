{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CodeCraft parser output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "parser_version",
    "python",
    "go",
    "files",
    "excluded_directories",
    "edges",
    "symbol_references",
    "star_import_references",
    "cgo_references",
    "unresolved_references",
    "external_references",
    "excluded_references",
    "coverage",
    "file_coverage"
  ],
  "properties": {
    "parser_version": { "type": "string" },
    "python": {
      "anyOf": [
        { "$ref": "#/$defs/python_repository_details" },
        { "type": "null" }
      ]
    },
    "go": {
      "anyOf": [
        { "$ref": "#/$defs/go_repository_details" },
        { "type": "null" }
      ]
    },
    "typescript": {
      "anyOf": [
        { "$ref": "#/$defs/typescript_repository_details" },
        { "type": "null" }
      ]
    },
    "files": {
      "type": "array",
      "items": { "$ref": "#/$defs/file_record" }
    },
    "excluded_directories": {
      "type": "array",
      "items": { "$ref": "#/$defs/excluded_directory" }
    },
    "edges": {
      "type": "array",
      "items": { "$ref": "#/$defs/edge" }
    },
    "symbol_references": {
      "type": "array",
      "items": { "$ref": "#/$defs/symbol_record" }
    },
    "star_import_references": {
      "type": "array",
      "items": { "$ref": "#/$defs/star_import_record" }
    },
    "cgo_references": {
      "type": "array",
      "items": { "$ref": "#/$defs/cgo_reference" }
    },
    "unresolved_references": {
      "type": "array",
      "items": { "$ref": "#/$defs/reference_record" }
    },
    "external_references": {
      "type": "array",
      "items": { "$ref": "#/$defs/external_reference" }
    },
    "excluded_references": {
      "type": "array",
      "items": { "$ref": "#/$defs/reference_record" }
    },
    "coverage": { "$ref": "#/$defs/coverage" },
    "file_coverage": { "$ref": "#/$defs/file_coverage" }
  },
  "$defs": {
    "parse_failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason", "line", "column"],
      "properties": {
        "reason": { "type": "string" },
        "line": { "type": ["integer", "null"], "minimum": 1 },
        "column": { "type": ["integer", "null"], "minimum": 1 }
      }
    },
    "python_file_details": {
      "type": "object",
      "additionalProperties": false,
      "required": ["module", "package_kind", "is_package"],
      "properties": {
        "module": { "type": ["string", "null"] },
        "package_kind": { "enum": ["regular", "namespace", null] },
        "is_package": { "type": "boolean" }
      }
    },
    "go_build_constraint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "expression"],
      "properties": {
        "source": { "enum": ["build_line", "filename"] },
        "expression": { "type": "string" }
      }
    },
    "go_file_details": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "package",
        "module_path",
        "build_constraints",
        "is_test",
        "build_constraint_exclusion_reason"
      ],
      "properties": {
        "package": { "type": "string" },
        "module_path": { "type": ["string", "null"] },
        "build_constraints": {
          "type": "array",
          "items": { "$ref": "#/$defs/go_build_constraint" }
        },
        "is_test": { "type": "boolean" },
        "build_constraint_exclusion_reason": { "type": ["string", "null"] }
      }
    },
    "go_build_context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "arch"],
      "properties": {
        "os": { "type": "string" },
        "arch": { "type": "string" }
      }
    },
    "go_module": {
      "type": "object",
      "additionalProperties": false,
      "required": ["module_path", "folder", "source"],
      "properties": {
        "module_path": { "type": "string" },
        "folder": { "type": "string" },
        "source": { "enum": ["module_file", "workspace", "replace"] }
      }
    },
    "go_repository_details": {
      "type": "object",
      "additionalProperties": false,
      "required": ["build_context", "modules"],
      "properties": {
        "build_context": { "$ref": "#/$defs/go_build_context" },
        "modules": {
          "type": "array",
          "items": { "$ref": "#/$defs/go_module" }
        }
      }
    },
    "go_coverage_details": {
      "type": "object",
      "additionalProperties": false,
      "required": ["packages"],
      "properties": {
        "packages": { "type": "integer", "minimum": 0 }
      }
    },
    "resolution_path": {
      "enum": [
        "path_alias",
        "workspace_package",
        "package_entry_point",
        "index_file",
        "extension",
        "relative",
        "asset"
      ]
    },
    "typescript_file_kind": {
      "enum": ["source", "declaration"]
    },
    "typescript_file_details": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "$ref": "#/$defs/typescript_file_kind" }
      }
    },
    "typescript_repository_details": {
      "type": "object",
      "additionalProperties": false,
      "required": ["config_files"],
      "properties": {
        "config_files": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "typescript_coverage_details": {
      "type": "object",
      "additionalProperties": false,
      "required": ["re_exports", "re_exports_resolved"],
      "properties": {
        "re_exports": { "type": "integer", "minimum": 0 },
        "re_exports_resolved": { "type": "integer", "minimum": 0 }
      }
    },
    "file_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "folder",
        "language",
        "line_count",
        "content_hash",
        "is_node",
        "excluded_reason",
        "parse_failure",
        "adapter_role",
        "python",
        "go"
      ],
      "properties": {
        "path": { "type": "string" },
        "folder": { "type": "string" },
        "language": { "enum": ["python", "go", "typescript", "javascript", null] },
        "line_count": { "type": ["integer", "null"], "minimum": 0 },
        "content_hash": {
          "anyOf": [
            { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
            { "type": "null" }
          ]
        },
        "is_node": { "type": "boolean" },
        "excluded_reason": { "type": ["string", "null"] },
        "parse_failure": {
          "anyOf": [
            { "$ref": "#/$defs/parse_failure" },
            { "type": "null" }
          ]
        },
        "adapter_role": { "enum": ["fallback"] },
        "python": {
          "anyOf": [
            { "$ref": "#/$defs/python_file_details" },
            { "type": "null" }
          ]
        },
        "go": {
          "anyOf": [
            { "$ref": "#/$defs/go_file_details" },
            { "type": "null" }
          ]
        },
        "typescript": {
          "anyOf": [
            { "$ref": "#/$defs/typescript_file_details" },
            { "type": "null" }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "is_node": { "const": true },
              "language": { "const": "python" }
            },
            "required": ["is_node", "language"]
          },
          "then": {
            "properties": {
              "python": { "$ref": "#/$defs/python_file_details" },
              "go": { "type": "null" }
            },
            "required": ["python", "go"]
          }
        },
        {
          "if": {
            "properties": {
              "is_node": { "const": true },
              "language": { "const": "go" }
            },
            "required": ["is_node", "language"]
          },
          "then": {
            "properties": {
              "go": { "$ref": "#/$defs/go_file_details" },
              "python": { "type": "null" }
            },
            "required": ["go", "python"]
          }
        },
        {
          "if": {
            "properties": {
              "is_node": { "const": true },
              "language": { "enum": ["typescript", "javascript"] }
            },
            "required": ["is_node", "language"]
          },
          "then": {
            "properties": {
              "typescript": { "$ref": "#/$defs/typescript_file_details" },
              "python": { "type": "null" },
              "go": { "type": "null" }
            },
            "required": ["typescript", "python", "go"]
          }
        }
      ]
    },
    "excluded_directory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "reason"],
      "properties": {
        "path": { "type": "string" },
        "reason": { "type": "string" }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "target",
        "target_kind",
        "kind",
        "condition",
        "alias",
        "line",
        "column"
      ],
      "properties": {
        "source": { "type": "string" },
        "target": { "type": "string" },
        "target_kind": { "enum": ["file", "package"] },
        "kind": {
          "enum": [
            "import",
            "dynamic_import",
            "blank_import",
            "dot_import",
            "re_export",
            "type_only_import",
            "asset_import"
          ]
        },
        "condition": { "enum": ["type_only", "optional", "lazy", null] },
        "alias": { "type": ["string", "null"] },
        "resolution_path": {
          "anyOf": [
            { "$ref": "#/$defs/resolution_path" },
            { "type": "null" }
          ]
        },
        "line": { "type": "integer", "minimum": 1 },
        "column": { "type": "integer", "minimum": 1 }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "enum": ["re_export", "type_only_import", "asset_import"]
              }
            },
            "required": ["kind"]
          },
          "then": {
            "properties": {
              "target_kind": { "const": "file" },
              "resolution_path": { "$ref": "#/$defs/resolution_path" }
            },
            "required": ["target_kind", "resolution_path"]
          }
        }
      ]
    },
    "symbol_record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "module", "name", "status", "line", "column"],
      "properties": {
        "source": { "type": "string" },
        "module": { "type": "string" },
        "name": { "type": "string" },
        "status": { "enum": ["symbol of resolved module, not verified"] },
        "line": { "type": "integer", "minimum": 1 },
        "column": { "type": "integer", "minimum": 1 }
      }
    },
    "star_import_record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "module", "status", "line", "column"],
      "properties": {
        "source": { "type": "string" },
        "module": { "type": "string" },
        "status": { "enum": ["names not enumerated"] },
        "line": { "type": "integer", "minimum": 1 },
        "column": { "type": "integer", "minimum": 1 }
      }
    },
    "cgo_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "reference", "status", "line", "column"],
      "properties": {
        "source": { "type": "string" },
        "reference": { "type": "string" },
        "status": { "enum": ["cgo pseudo-package"] },
        "line": { "type": "integer", "minimum": 1 },
        "column": { "type": "integer", "minimum": 1 }
      }
    },
    "reference_record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "reference", "reason", "line", "column"],
      "properties": {
        "source": { "type": "string" },
        "reference": { "type": "string" },
        "reason": { "type": "string" },
        "line": { "type": "integer", "minimum": 1 },
        "column": { "type": "integer", "minimum": 1 }
      }
    },
    "external_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "reference", "top_level", "line", "column"],
      "properties": {
        "source": { "type": "string" },
        "reference": { "type": "string" },
        "top_level": { "type": "string" },
        "line": { "type": "integer", "minimum": 1 },
        "column": { "type": "integer", "minimum": 1 }
      }
    },
    "python_coverage_details": {
      "type": "object",
      "additionalProperties": false,
      "required": ["namespace_packages"],
      "properties": {
        "namespace_packages": { "type": "integer", "minimum": 0 }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "references",
        "resolved",
        "symbols",
        "star_imports",
        "cgo",
        "external",
        "excluded",
        "failed",
        "python",
        "go",
        "failures_by_reason",
        "failure_examples"
      ],
      "properties": {
        "references": { "type": "integer", "minimum": 0 },
        "resolved": { "type": "integer", "minimum": 0 },
        "symbols": { "type": "integer", "minimum": 0 },
        "star_imports": { "type": "integer", "minimum": 0 },
        "cgo": { "type": "integer", "minimum": 0 },
        "external": { "type": "integer", "minimum": 0 },
        "excluded": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 },
        "python": {
          "anyOf": [
            { "$ref": "#/$defs/python_coverage_details" },
            { "type": "null" }
          ]
        },
        "go": {
          "anyOf": [
            { "$ref": "#/$defs/go_coverage_details" },
            { "type": "null" }
          ]
        },
        "typescript": {
          "anyOf": [
            { "$ref": "#/$defs/typescript_coverage_details" },
            { "type": "null" }
          ]
        },
        "failures_by_reason": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        },
        "failure_examples": {
          "type": "array",
          "items": { "$ref": "#/$defs/reference_record" }
        }
      }
    },
    "file_coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["found", "parsed", "failed_parse", "excluded", "excluded_by_reason"],
      "properties": {
        "found": { "type": "integer", "minimum": 0 },
        "parsed": { "type": "integer", "minimum": 0 },
        "failed_parse": { "type": "integer", "minimum": 0 },
        "excluded": { "type": "integer", "minimum": 0 },
        "assets": { "type": "integer", "minimum": 0 },
        "excluded_by_reason": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "python_repository_details": {
      "type": "object",
      "additionalProperties": false,
      "required": ["import_root", "import_root_rule"],
      "properties": {
        "import_root": { "type": "string" },
        "import_root_rule": { "type": "string" }
      }
    }
  }
}
